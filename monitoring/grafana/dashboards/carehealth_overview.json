        {
          "expr": "histogram_quantile(0.99, sum(rate(carehealth_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "API Response Latency Percentiles",
