# ==============================================================================
# CareHealth Point – Environment Configuration Template
# Course: DevOps & Automation Lab (ENSP461)
# Note: Copy this file to .env for local configuration. Never commit actual secrets!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CareHealth Point"
VERSION=1.0.0

# Security & JWT Configuration
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in Docker / Kubernetes)
POSTGRES_USER=carehealth_admin
POSTGRES_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD
POSTGRES_DB=carehealth_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://carehealth_admin:CHANGE_ME_SECURE_POSTGRES_PASSWORD@postgres:5432/carehealth_db

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
PORT=3000
VITE_ENABLE_DEMO_LOGIN=false # Set to true only in local development/evaluation to enable 1-click demo persona switcher

# Demo Persona Credentials (For local academic viva evaluation only)
# Configure these in your local uncommitted .env file
VITE_DEMO_ADMIN_EMAIL=admin@example.com
VITE_DEMO_ADMIN_PASSWORD=CHANGE_ME_IN_LOCAL_ENV
VITE_DEMO_DOCTOR_EMAIL=doctor@example.com
VITE_DEMO_DOCTOR_PASSWORD=CHANGE_ME_IN_LOCAL_ENV
VITE_DEMO_RECEPTIONIST_EMAIL=receptionist@example.com
VITE_DEMO_RECEPTIONIST_PASSWORD=CHANGE_ME_IN_LOCAL_ENV
VITE_DEMO_PATIENT_EMAIL=patient@example.com
VITE_DEMO_PATIENT_PASSWORD=CHANGE_ME_IN_LOCAL_ENV

# Docker & Container Registry
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_BACKEND=carehealth/backend:1.0.0
DOCKER_IMAGE_FRONTEND=carehealth/frontend:1.0.0
