# ==============================================================================
# CareHealth Point – Environment Configuration Template
# Course: DevOps & Automation Lab (ENSP461)
# Note: Copy this file to .env for local configuration. Never commit actual secrets!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CareHealth Point"
VERSION=1.0.0

# Security & JWT Configuration
SECRET_KEY=carehealth-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in Docker / Kubernetes)
POSTGRES_USER=carehealth_admin
POSTGRES_PASSWORD=carehealth_secure_pass_2026
POSTGRES_DB=carehealth_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://carehealth_admin:carehealth_secure_pass_2026@postgres:5432/carehealth_db

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
PORT=3000

# Docker & Container Registry
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_BACKEND=carehealth/backend:1.0.0
DOCKER_IMAGE_FRONTEND=carehealth/frontend:1.0.0
