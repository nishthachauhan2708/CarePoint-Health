# ==============================================================================
# CareHealth Point – Kubernetes Secret Template (Example)
# Course: DevOps & Automation Lab (ENSP461)
# Note: Copy this file to secret.yaml and set your own secure credentials.
#       Never commit your actual secret.yaml to a public repository!
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: carehealth-secrets
  namespace: carehealth
  labels:
    app.kubernetes.io/name: carehealth-point
type: Opaque
stringData:
  SECRET_KEY: "CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET_KEY"
  POSTGRES_PASSWORD: "CHANGE_ME_TO_A_STRONG_POSTGRES_PASSWORD"
  DATABASE_URL: "postgresql://carehealth_admin:CHANGE_ME_TO_A_STRONG_POSTGRES_PASSWORD@carehealth-postgres-service:5432/carehealth_db"
